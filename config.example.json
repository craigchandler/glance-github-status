{
  "username": "octocat",
  "accounts": {
    "default": {
      "tokenEnv": "GITHUB_TOKEN"
    }
  },
  "repositories": [
    {
      "name": "octocat/example",
      "account": "default"
    }
  ],
  "maxItems": 8,
  "recentRunsPerRepo": 3,
  "security": {
    "dependabot": true,
    "codeScanning": true,
    "secretScanning": true,
    "minimumSeverity": "medium"
  }
}
